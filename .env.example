# API Keys
YOUTUBE_API_KEY=your_youtube_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # Used for GPT-4o (scripts) and DALL-E 3 (images)

# YouTube OAuth2 (for uploading)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Settings
DEFAULT_LANGUAGE=en
MAX_SEARCH_RESULTS=20
TTS_VOICE=en-US-AriaNeural

# Quality filters
MIN_VIEW_COUNT=50000
MIN_SUBSCRIBER_COUNT=10000